# ==============================================================================
# ODD/EVEN AI TRADER - Variáveis de Ambiente de Exemplo
# ==============================================================================
# ATENÇÃO: NUNCA insira tokens ou chaves reais neste arquivo ou submeta ao Git.
# ==============================================================================

# Modo de Operação (OBRIGATÓRIO: "DEMO")
# Qualquer valor diferente de "DEMO" causará a recusa de inicialização pelo sistema de segurança.
ACCOUNT_MODE=DEMO
ALLOW_REAL_ACCOUNT=False

# Configuração da Aplicação
APP_NAME=ODD_EVEN_AI_TRADER
APP_ENV=development
APP_PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Configurações Oficiais da API Deriv
# Endpoint oficial do WebSocket da Deriv (Novo Endpoint Options / Public Data)
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
# Registre sua App ID em: https://api.deriv.com ou utilize o ID público de teste (1089)
DERIV_APP_ID=1089
# Token da conta DEMO (gerado nas configurações de segurança da sua conta demo na Deriv)
# Formato típico: sequencia alfanumérica de 15 a 20 caracteres
DERIV_DEMO_TOKEN=seu_token_demo_aqui
# Símbolo sintético padrão para monitoramento
DERIV_DEFAULT_SYMBOL=R_100

# Parâmetros de Gestão de Risco e Salvaguardas
# Valor máximo de stake por trade (em USD)
RISK_MAX_STAKE_USD=5.00
# Percentual máximo de risco da banca por operação (ex: 0.01 = 1%)
RISK_MAX_STAKE_PERCENT=0.01
# Limite máximo de perdas consecutivas antes do bloqueio temporário
RISK_MAX_CONSECUTIVE_LOSSES=3
# Limite máximo de perda acumulada diária (Drawdown em USD)
RISK_MAX_DAILY_LOSS_USD=25.00
# Kill switch ativado por padrão (True = bloqueia execuções até desarme explícito)
RISK_KILL_SWITCH_ACTIVE=False
# Proibição absoluta de Martingale (SEMPRE True)
RISK_BAN_MARTINGALE=True

# Parâmetros Quantitativos e Validação Matemática
# Payout multiplicador mínimo aceitável para considerar uma proposta (ex: 1.90)
MIN_ACCEPTABLE_PAYOUT_RATIO=1.90
# Expectativa matemática líquida mínima por operação (Net EV ratio > 0, ex: 0.01 = +1%)
MIN_NET_EV_RATIO=0.01
# Nível de significância estatística mínima (ex: 0.95 = 95% de confiança Wilson)
CONFIDENCE_LEVEL=0.95
# Amostra mínima de ticks históricos antes de permitir inferência de probabilidade
MIN_TICK_SAMPLE_SIZE=500

# Persistência e Cache
DATABASE_URL=postgresql://deriv_user:deriv_pass@postgres:5432/deriv_trader
REDIS_URL=redis://redis:6379/0

# Mapeamento de Portas Externas (Host da VPS / Coolify)
BACKEND_PORT=8001
FRONTEND_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6380
